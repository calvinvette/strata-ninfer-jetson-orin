index 6dc583f4..12af3bf2 100644
--- a/src/kernels/native_expert_parity.cpp
+++ b/src/kernels/native_expert_parity.cpp
@@ -129,6 +129,67 @@ int check_q8_1_quantizers(const std::vector<float>& x, cudaStream_t stream) {
