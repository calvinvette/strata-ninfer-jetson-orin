+bool q8_1_selector_known(const char* selector) {
+    return std::strcmp(selector, "0") == 0 || std::strcmp(selector, "1") == 0 ||
+           std::strcmp(selector, "all") == 0 || std::strcmp(selector, "iq2_s/q2_0") == 0 ||
